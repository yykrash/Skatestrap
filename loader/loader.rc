1 ICON "../launcher/icon.ico"
1 24 "loader.manifest"

// Loader's own version: bump ONLY when loader code changes (a new loader.exe is a new file to Windows Defender;
// an unchanged one keeps its reputation across launcher releases). Also bump loader.manifest's version.
1 VERSIONINFO
FILEVERSION 0,0,15,0
PRODUCTVERSION 0,0,15,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "yykrash"
      VALUE "FileDescription", "Skatestrap game loader"
      VALUE "FileVersion", "0.0.15"
      VALUE "InternalName", "loader"
      VALUE "LegalCopyright", "Apache-2.0, github.com/yykrash/Skatestrap"
      VALUE "OriginalFilename", "loader.exe"
      VALUE "ProductName", "Skatestrap"
      VALUE "ProductVersion", "0.0.15"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
