<ui:FluentWindow x:Class="Skatestrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Skatestrap"
        Title="Skatestrap" Width="980" Height="640" MinWidth="760" MinHeight="500"
        Icon="pack://application:,,,/icon.png" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Skatestrap" Grid.Row="0">
            <ui:TitleBar.Icon><ui:ImageIcon Source="pack://application:,,,/icon.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <ui:NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           OpenPaneLength="200" IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Play" TargetPageType="{x:Type local:PlayPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Play24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Graphics" TargetPageType="{x:Type local:GraphicsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Quality" TargetPageType="{x:Type local:QualityPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DrawImage24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Performance" TargetPageType="{x:Type local:PerformancePage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="TopSpeed24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Mods" TargetPageType="{x:Type local:ModsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Fast Flags" TargetPageType="{x:Type local:FlagsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Flag24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Debug" TargetPageType="{x:Type local:DebugPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Bug24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="About" TargetPageType="{x:Type local:AboutPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
        <Grid x:Name="UpdateOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#CC101014" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock x:Name="UpdateText" Margin="0,16,0,0" FontSize="16" Foreground="White"
                           HorizontalAlignment="Center" Text="Checking for updates…" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
