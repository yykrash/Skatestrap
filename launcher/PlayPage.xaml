<Page x:Class="Skatestrap.PlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Play">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TextBlock Grid.Row="0" FontTypography="Title" Text="Play" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
            <ComboBox x:Name="AccountBox" Width="200" Height="40" VerticalContentAlignment="Center" ToolTip="Roblox account" SelectionChanged="Account_Changed" />
            <ui:Button x:Name="RemoveButton" Height="40" Margin="4,0,8,0" ToolTip="Remove this account from Skatestrap" Click="Remove_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="PlayButton" Appearance="Primary" Content="Play" Width="140" Height="40" Click="Play_Click">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
            </ui:Button>
            <ui:Button x:Name="StopButton" Content="Stop" Width="100" Height="40" Margin="8,0,0,0" Click="Stop_Click" IsEnabled="False" />
            <ui:TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ui:TextBlock x:Name="RecentTitle" Grid.Row="2" FontTypography="Subtitle" Text="Continue playing" Margin="0,12,0,8" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="236" Margin="0,0,10,10" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Image Source="{Binding Image}" Height="133" Stretch="UniformToFill" />
                                <StackPanel Margin="10,8,10,10">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock Text="{Binding Creator}" TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBlock Text="{Binding Stats}" Margin="0,4,0,0" />
                                    <ui:TextBlock Text="{Binding Joined}" FontSize="11" Margin="0,2,0,8"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Tag="{Binding PlaceId}" Click="PlayGame_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
