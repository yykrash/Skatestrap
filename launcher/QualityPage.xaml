<Page x:Class="Skatestrap.QualityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Quality">
    <StackPanel Margin="24,8,24,24">
        <ui:TextBlock FontTypography="Title" Text="Quality" Margin="0,0,0,4" />
        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="Same flags Bloxstrap and Voidstrap set. A flag you type on the Fast Flags page wins over these." />

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Laptop24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Low graphics (laptops)" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="Locks Roblox graphics quality to 1. Turn on if your PC has no graphics card: the built-in GPU shares power and heat with the CPU, so less GPU work keeps the game's tick fast. The in-game graphics slider does nothing while this is on." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="LowSwitch" Click="Changed" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="EarthLeaf24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="No grass" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="Grass render distance 0: no grass anywhere. Faster on weak PCs." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="GrassSwitch" Click="Changed" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="WeatherSqualls24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Still grass" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="Grass does not sway in the wind." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="StillSwitch" Click="Changed" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Blur24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Anti-aliasing (MSAA)" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="Smooths jagged edges. Higher costs more GPU." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="MsaaBox" MinWidth="200" SelectionChanged="Changed">
                <ComboBoxItem Content="Roblox decides" Tag="" />
                <ComboBoxItem Content="Off (1x)" Tag="1" />
                <ComboBoxItem Content="2x" Tag="2" />
                <ComboBoxItem Content="4x" Tag="4" />
                <ComboBoxItem Content="8x" Tag="8" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,8">
            <ui:CardControl.Icon><ui:SymbolIcon Symbol="DrawImage24" /></ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Texture quality" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="Lower saves video memory and loads faster." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="TexBox" MinWidth="200" SelectionChanged="Changed">
                <ComboBoxItem Content="Roblox decides" Tag="" />
                <ComboBoxItem Content="Lowest" Tag="0" />
                <ComboBoxItem Content="Low" Tag="1" />
                <ComboBoxItem Content="Medium" Tag="2" />
                <ComboBoxItem Content="Highest" Tag="3" />
            </ComboBox>
        </ui:CardControl>
    </StackPanel>
</Page>
